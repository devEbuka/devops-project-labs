# Local only; copy to .env and generate a random JWT secret of at least 32 characters.
DATABASE_URL=postgresql+psycopg://inventory:local-dev-only@localhost:5432/inventory
JWT_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRE_MINUTES=30
INSTANCE_ID=local
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
